# Copia este archivo a backend/.env y completa los valores.

# Rutas (relativas a backend/)
ML_OUTPUTS_DIR=../ml/outputs
CONTRACTS_DIR=../contracts
DATABASE_PATH=data/app.db

# Recarga de datos de ML: POST /api/admin/reload
# Si queda vacío, el endpoint rechaza todas las peticiones con 401.
ADMIN_TOKEN=

# Chat de la asamblea (Google Gemini)
# Sin LLM_API_KEY o sin LLM_MODEL, POST /api/chat responde 502 llm_unavailable.
LLM_API_KEY=
# Modelo Flash vigente en https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-2.5-flash

# CORS: "*" para desarrollo o lista separada por comas
CORS_ORIGINS=*

# NASA POWER: una sola consulta para toda la zona (altiplano)
NASA_POWER_LAT=-17.09
NASA_POWER_LON=-68.0
NASA_POWER_TIMEOUT_S=30
