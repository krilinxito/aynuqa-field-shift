{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respuesta de GET /api/sectors",
  "type": "object",
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_source": {
      "enum": [
        "mock",
        "real"
      ],
      "description": "mock si son los ejemplos de contracts/, real si vienen de ML."
    },
    "scenario": {
      "enum": [
        "normal",
        "nino"
      ],
      "description": "nino es el estado real de hoy; normal es la comparacion."
    },
    "zone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "roni": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "season": {
              "type": [
                "string",
                "null"
              ],
              "description": "Temporada de tres meses, por ejemplo ASO. null si el valor es supuesto."
            },
            "year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "observed",
                "assumed"
              ],
              "description": "observed en el escenario nino; assumed en el escenario normal."
            }
          },
          "required": [
            "value",
            "season",
            "year",
            "kind"
          ],
          "additionalProperties": false,
          "description": "Indice relativo de El Nino (RONI) de NOAA usado en el escenario."
        },
        "climate": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "precip_mm": {
              "type": [
                "number",
                "null"
              ],
              "description": "Lluvia total del mes, en mm."
            },
            "precip_anomaly_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "temp_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "temp_anomaly_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "soil_moisture": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "Humedad de la zona de raices, fraccion de 0 a 1 (GWETROOT)."
            },
            "soil_moisture_anomaly": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "period",
            "precip_mm",
            "precip_anomaly_pct",
            "temp_c",
            "temp_anomaly_c",
            "soil_moisture",
            "soil_moisture_anomaly"
          ],
          "additionalProperties": false,
          "description": "Clima observado de la zona. Es igual para todos los sectores."
        }
      },
      "required": [
        "id",
        "name",
        "lat",
        "lon",
        "roni",
        "climate"
      ],
      "additionalProperties": false
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "const": "Polygon"
              },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "required": [
              "type",
              "coordinates"
            ],
            "additionalProperties": false,
            "description": "Poligono GeoJSON, coordenadas [lon, lat]. Simulado."
          },
          "centroid": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          },
          "area_ha": {
            "type": "number"
          },
          "terrain": {
            "type": "object",
            "properties": {
              "elevation_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "slope_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "aspect_deg": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "elevation_m",
              "slope_pct",
              "aspect_deg"
            ],
            "additionalProperties": false,
            "description": "De NASADEM. Real."
          },
          "rotation": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "resting",
                  "cultivated"
                ]
              },
              "years_in_status": {
                "type": "integer",
                "minimum": 0
              },
              "is_simulated": {
                "const": true
              }
            },
            "required": [
              "status",
              "years_in_status",
              "is_simulated"
            ],
            "additionalProperties": false,
            "description": "Estado de la rotacion. Simulado segun el ciclo publicado de Pumani."
          },
          "vegetation": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "ndvi": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "NDVI del sector, de -1 a 1. null si falta."
              },
              "ndvi_anomaly": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Desviaciones estandar respecto al mismo mes desde 2000."
              }
            },
            "required": [
              "date",
              "ndvi",
              "ndvi_anomaly"
            ],
            "additionalProperties": false,
            "description": "Ultimo NDVI disponible del sector. Real."
          },
          "risk": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "level": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "description": "low si score < 0.33, medium si < 0.66, high en otro caso."
              },
              "interval": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "high": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "low",
                  "high"
                ],
                "additionalProperties": false,
                "description": "Intervalo del modelo de cuantiles."
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence_label": {
                "enum": [
                  "baja",
                  "media",
                  "alta"
                ],
                "description": "baja si confidence < 0.4, media hasta 0.7, alta por encima."
              },
              "drivers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "feature": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Nombre de la variable del modelo."
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Explicacion en espanol simple."
                    },
                    "direction": {
                      "enum": [
                        "increases",
                        "decreases"
                      ]
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Peso relativo de la variable (SHAP normalizado)."
                    }
                  },
                  "required": [
                    "feature",
                    "label",
                    "direction",
                    "weight"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "score",
              "level",
              "interval",
              "confidence",
              "confidence_label",
              "drivers"
            ],
            "additionalProperties": false,
            "description": "Riesgo de sequia del proximo ciclo."
          },
          "recovery": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "level": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence_label": {
                "enum": [
                  "baja",
                  "media",
                  "alta"
                ]
              },
              "ndvi_residual": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "NDVI corregido por lluvia (RESTREND)."
              }
            },
            "required": [
              "score",
              "level",
              "confidence",
              "confidence_label",
              "ndvi_residual"
            ],
            "additionalProperties": false,
            "description": "Recuperacion del suelo durante el descanso."
          },
          "recommendation": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "open",
                  "extend_rest",
                  "start_rest",
                  "keep_cultivating"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Recomendacion en espanol simple."
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "extend_rest_years": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "crop": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sowing_window": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence_label": {
                "enum": [
                  "baja",
                  "media",
                  "alta"
                ]
              }
            },
            "required": [
              "action",
              "text",
              "reasons",
              "extend_rest_years",
              "crop",
              "sowing_window",
              "confidence",
              "confidence_label"
            ],
            "additionalProperties": false
          },
          "twin_precedent": {
            "anyOf": [
              {
                "$ref": "#/$defs/twin_precedent"
              },
              {
                "type": "null"
              }
            ],
            "description": "Precedente en una tierra gemela, o null si no aplica."
          },
          "is_simulated": {
            "const": true,
            "description": "Los limites del sector y sus anios de descanso son simulados."
          }
        },
        "required": [
          "id",
          "name",
          "geometry",
          "centroid",
          "area_ha",
          "terrain",
          "rotation",
          "vegetation",
          "risk",
          "recovery",
          "recommendation",
          "twin_precedent",
          "is_simulated"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "updated_at",
    "data_source",
    "scenario",
    "zone",
    "sectors"
  ],
  "additionalProperties": false,
  "$defs": {
    "twin_precedent": {
      "type": "object",
      "properties": {
        "sector_id": {
          "type": "string",
          "pattern": "^S\\d+$"
        },
        "twin_zone": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre de la zona analoga donde esta la tierra gemela."
        },
        "twin_elevation_m": {
          "type": "number"
        },
        "twin_slope_pct": {
          "type": "number"
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Parecido fisico entre el sector y su tierra gemela, de 0 a 1."
        },
        "event": {
          "enum": [
            "2015-16",
            "2023-24"
          ],
          "description": "El Nino pasado al que corresponde el precedente."
        },
        "observed_ndvi_anomaly": {
          "type": [
            "number",
            "null"
          ],
          "description": "Anomalia de NDVI observada en la tierra gemela durante el evento, en desviaciones estandar. Dato real."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_label": {
          "enum": [
            "baja",
            "media",
            "alta"
          ]
        },
        "is_simulated": {
          "type": "boolean",
          "description": "false: el NDVI y el terreno de la tierra gemela son mediciones reales."
        }
      },
      "required": [
        "sector_id",
        "twin_zone",
        "twin_elevation_m",
        "twin_slope_pct",
        "similarity",
        "event",
        "observed_ndvi_anomaly",
        "confidence",
        "confidence_label",
        "is_simulated"
      ],
      "additionalProperties": false
    }
  }
}
