# Variables para Dokploy > Environment (docker-compose.dokploy.yml).
# Copie este contenido en Dokploy y reemplace cada valor. No lo suba con valores reales.

# Dominio público, con https y sin barra al final.
PUBLIC_URL=https://aynuqa.example.com

# Contraseñas y tokens: use valores largos y aleatorios (por ejemplo: openssl rand -hex 24).
POSTGRES_PASSWORD=cambiar
POWERSYNC_STORAGE_PASSWORD=cambiar
POWERSYNC_ADMIN_TOKEN=cambiar
ADMIN_TOKEN=cambiar

# Chat con Gemini. Sin estos dos valores el chat en línea no responde
# (la app sigue funcionando y la llamita contesta con los datos guardados).
LLM_API_KEY=
# Un modelo Flash vigente: https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=

# Voz nativa en aymara y quechua (Meta MMS). true agrega ~700 MB a la imagen del backend.
TTS_LOCAL=false
